# Aurora PostgreSQL (Free Tier, Express configuration, IAM authentication --
# no password; AWS credentials for token generation come from `aws configure`,
# not from this file)
AURORA_HOST=your-cluster-endpoint.rds.amazonaws.com
AURORA_PORT=5432
AURORA_DB=postgres
AURORA_USER=postgres
AWS_REGION=us-east-1

# Embedding model (local, free — sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# PubMed E-utilities (optional, raises your rate limit if set)
PUBMED_API_KEY=[email protected]
PUBMED_EMAIL=[email protected]
