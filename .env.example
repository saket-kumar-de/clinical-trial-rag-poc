# Aurora PostgreSQL (Free Tier, Express configuration)
AURORA_HOST=your-cluster-endpoint.rds.amazonaws.com
AURORA_PORT=5432
AURORA_DB=clinical_rag
AURORA_USER=postgres
AURORA_PASSWORD=change-me

# Embedding model (local, free — sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# PubMed E-utilities (optional, raises your rate limit if set)
PUBMED_API_KEY=
[email protected]
